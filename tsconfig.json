{
  // https://aka.ms/tsconfig
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./scripts",
    
    // get rid of unnecessities
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    // we dont wanna see nasty stuff in distributed production :shush:
    "removeComments": true
  }
}
